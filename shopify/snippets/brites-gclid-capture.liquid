{% comment %}
  brites-gclid-capture.liquid — v2 (2026-09-17)

  Captures the Google Ads click id (gclid / gbraid / wbraid) from the ad landing URL
  and attaches it to the cart so it lands on the order as a note_attribute — which
  shopifyOrderWebhook.js reads to attribute the sale back to the click.

  Without this snippet every paid order still records, but with no click id, and
  Google Ads under-reports the revenue it earned. Nothing goes red when that
  happens, so shopifyAttributionCheck verifies this file is installed and reports
  the version marker below.

  INSTALL:
    1. Save this file as snippets/brites-gclid-capture.liquid
    2. In layout/theme.liquid, add this line just before </body>:
         {% render 'brites-gclid-capture' %}
    (Works with auto-tagging ON in Google Ads — the default — which appends gclid
     to the ad's landing URL. No gtag/conversion tag needed for the server-side path.)

  v2 fixes three ways a click id was lost silently:
    · a failed /cart/update.js was recorded as a success, because fetch() only
      rejects on a network error and the response status was never checked;
    · a second ad click in the same session never reached the cart, so the sale
      was credited to the first click;
    · an emptied cart drops its attributes, and the once-per-session flag stopped
      them ever being reapplied.
{% endcomment %}
<script>
(function () {
  try {
    var VERSION = "brites-gclid-capture/2";
    var PARAMS = ["gclid", "gbraid", "wbraid"];
    var COOKIE = "_brites_click";
    var SYNCED = "_brites_click_synced";
    var DAYS = 90;

    function getParam(n) {
      try { return new URLSearchParams(window.location.search).get(n); }
      catch (e) {
        var m = window.location.search.match(new RegExp("[?&]" + n + "=([^&]+)"));
        return m ? decodeURIComponent(m[1]) : null;
      }
    }
    function setCookie(v) {
      var d = new Date(); d.setTime(d.getTime() + DAYS * 86400000);
      var secure = window.location.protocol === "https:" ? ";Secure" : "";
      document.cookie = COOKIE + "=" + encodeURIComponent(v) + ";expires=" + d.toUTCString() + ";path=/;SameSite=Lax" + secure;
    }
    function getCookie() {
      var m = document.cookie.match(/(?:^|;\s*)_brites_click=([^;]+)/);
      return m ? decodeURIComponent(m[1]) : "";
    }

    // 1) Capture from the landing URL (auto-tagging puts gclid on the ad click).
    //    A newer click replaces an older one: the sale belongs to the click that
    //    actually brought the visitor back.
    var captured = null;
    for (var i = 0; i < PARAMS.length; i++) {
      var val = getParam(PARAMS[i]);
      if (val) { captured = JSON.stringify({ k: PARAMS[i], v: val, t: Date.now() }); break; }
    }
    if (captured) setCookie(captured);

    // 2) Push the captured id into the cart -> becomes an order note_attribute.
    var raw = getCookie();
    if (!raw) return;
    var clk; try { clk = JSON.parse(raw); } catch (e) { return; }
    if (!clk || !clk.k || !clk.v) return;

    // Re-send whenever the click itself changed. Remembering WHICH id was synced,
    // rather than merely that something was, keeps a second ad click from being
    // credited to the first — while still not hammering /cart/update.js.
    var token = clk.k + "=" + clk.v;
    try { if (sessionStorage.getItem(SYNCED) === token) return; } catch (e) {}

    var attrs = {};
    attrs[clk.k] = clk.v;
    fetch("/cart/update.js", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ attributes: attrs })
    }).then(function (response) {
      // fetch() resolves on 4xx and 5xx too. Marking a refused write as synced
      // would retire the click id for the rest of the session.
      if (!response || !response.ok) return;
      try { sessionStorage.setItem(SYNCED, token); } catch (e) {}
    }).catch(function () {});
  } catch (e) { /* never break the storefront */ }
})();
</script>
