{
  "name": "etsy-app",
  "version": "1.0.0",
  "description": "Etsy listing and image upload application",
  "main": "index.js",
  "scripts": {
    "start": "netlify dev",
    "build": "vite build --config cherry-viewer/vite.config.js && cp cherry-viewer/_redirects cherry-viewer-dist/_redirects",
    "test:charm-nest": "node tests/charm-nest/solver.cjs && node tests/charm-nest/functions.cjs",
    "test:sku": "node tests/sku/sku-list.cjs && node tests/sku/exchange-token.cjs && node tests/sku/update-inventory.cjs && node tests/sku/shop-listings.cjs",
    "test:charm-nest:e2e": "node tests/charm-nest/e2e.cjs",
    "test:charm-nest:bridge": "node tests/charm-nest/bridge-units.cjs && node tests/charm-nest/bridge.cjs",
    "test:charm-nest:check": "node tests/charm-nest/check.cjs"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "node-fetch": "^2.6.1",
    "formidable": "^2.0.1",
    "form-data": "^4.0.0",
    "bootstrap": "^5.2.0",
    "firebase-admin": "^11.5.0",
    "@google-cloud/firestore": "^6.8.0",
    "@google-cloud/vision": "^4.3.1",
    "@google-cloud/storage": "^7.16.0",
    "sharp": "^0.33.5",
    "jszip": "^3.10.1",
    "@resvg/resvg-js": "^2.6.2",
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "three": "0.186.0"
  },
  "devDependencies": {
    "vite": "^5.0.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
